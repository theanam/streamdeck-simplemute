{
	"name": "streamdeck-simplemute",
	"version": "0.1.0",
	"private": true,
	"description": "Stream Deck plugin + Chrome extension that toggle mic and camera in browser meetings.",
	"type": "module",
	"scripts": {
		"check": "node scripts/check-extension.mjs",
		"test:extension": "vitest run",
		"test:plugin": "npm --prefix plugin test",
		"test": "npm run check && npm run test:extension && npm run test:plugin",
		"assets:store": "node scripts/make-store-assets.mjs",
		"pack:extension": "node scripts/pack-extension.mjs",
		"pack:plugin": "npm --prefix plugin run pack -- --force --output ../store/elgato",
		"pack": "npm run pack:extension && npm run pack:plugin",
		"publish:chrome": "npm run pack:extension && node scripts/publish-chrome.mjs --publish",
		"release": "node scripts/release.mjs"
	},
	"devDependencies": {
		"jsdom": "^26.1.0",
		"undici": "^8.12.3",
		"vitest": "^3.2.4"
	}
}
