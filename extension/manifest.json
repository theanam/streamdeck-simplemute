{
	"manifest_version": 3,
	"name": "SimpleMute for Stream Deck",
	"version": "0.1.0",
	"description": "Companion extension for the SimpleMute Stream Deck plugin. Lets a Stream Deck key mute or unmute your mic and camera in browser-based meetings.",
	"minimum_chrome_version": "116",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_title": "SimpleMute for Stream Deck",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png"
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"permissions": [
		"alarms",
		"scripting",
		"storage"
	],
	"host_permissions": [
		"https://meet.google.com/*",
		"https://*.zoom.us/wc/*",
		"https://teams.microsoft.com/*",
		"https://teams.live.com/*",
		"https://teams.cloud.microsoft/*"
	],
	"content_scripts": [
		{
			"matches": [
				"https://meet.google.com/*"
			],
			"js": [
				"content/common.js",
				"content/meet.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://*.zoom.us/wc/*"
			],
			"js": [
				"content/common.js",
				"content/zoom.js"
			],
			"all_frames": true,
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://teams.microsoft.com/*",
				"https://teams.live.com/*",
				"https://teams.cloud.microsoft/*"
			],
			"js": [
				"content/common.js",
				"content/teams.js"
			],
			"all_frames": true,
			"run_at": "document_idle"
		}
	]
}
